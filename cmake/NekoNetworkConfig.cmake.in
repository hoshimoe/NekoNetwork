@PACKAGE_INIT@

# Find required dependencies
# Note: find_dependency() must not be given REQUIRED or QUIET; it forwards the
# REQUIRED/QUIET-ness requested by the caller of find_package(NekoNetwork).
# All of these are linked PUBLIC by the exported target, so consumers need them.
include(CMakeFindDependencyMacro)
find_dependency(NekoSchema)
find_dependency(NekoFunction)
find_dependency(NekoSystem)
find_dependency(NekoLog)
find_dependency(CURL)

# Whether this build actually linked OpenSSL is decided at configure time:
# Windows builds against a Schannel-backed libcurl do not use it.
set(NEKO_NETWORK_USE_OPENSSL "@NEKO_NETWORK_USE_OPENSSL@")
if(NEKO_NETWORK_USE_OPENSSL)
    find_dependency(OpenSSL)
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/NekoNetworkTargets.cmake")

# Recreate alias for consumers
if(TARGET NekoNetwork AND NOT TARGET Neko::Network)
	add_library(Neko::Network ALIAS NekoNetwork)
endif()

check_required_components(NekoNetwork)